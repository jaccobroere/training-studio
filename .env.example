# Copy to .env and adjust. compose.yml reads this file twice: for its own ${...} values
# (ports, site address) and as the app's environment. Every variable the app reads is
# declared once in backend/core/settings.py; an empty value counts as unset.
# Never commit .env.

# --- Front door (bundled Caddy, see Caddyfile) -------------------------------------------
# Host port for plain HTTP. First run: http://localhost:8080
# HTTP_PORT=8080
# HTTPS_PORT=8443
# ":80" = plain HTTP. A domain (training.example.com) = automatic HTTPS via Let's Encrypt;
# then also set HTTP_PORT=80 and HTTPS_PORT=443 and point DNS at this host.
# SITE_ADDRESS=:80
# Behind another TLS-terminating reverse proxy: trust its X-Forwarded-* headers.
# TRUSTED_PROXIES=private_ranges
# The address users open; shown in the invite message `accounts.admin create` prints.
# PUBLIC_URL=http://localhost:8080
# Use a published image instead of building locally.
# APP_IMAGE=ghcr.io/jaccobroere/training-studio:latest
# Override the bundled Caddy image (compose.yml pins caddy:2.11.7 by digest).
# CADDY_IMAGE=

# --- Assistant (Ollama Cloud: chat, web search and fetch) --------------------------------
# One key shared by ALL accounts: one usage quota for everyone. Selected context (messages,
# attachments, data the assistant reads) is sent to Ollama Cloud. Unset: the assistant is
# off and the rest of the app works.
OLLAMA_API_KEY=
# Model name; SPORTS_MODEL (if set) wins over OLLAMA_MODEL.
# OLLAMA_MODEL=deepseek-v4.1-flash:1017
# SPORTS_MODEL=
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_WEB_API=https://ollama.com/api
# OLLAMA_REASONING_EFFORT=low       # low | medium | high
# SPORTS_MODEL_IMAGES=true          # false: never send image parts (text-only models)
# Assistant turns per account per week (reset Monday 00:00 in ATHLETE_TZ). Per-user
# overrides: python -m accounts.admin set-limit <user> <n|default>.
# ASSISTANT_WEEKLY_TURNS=200
# Turns across all accounts per week (one shared key, one bill); -1 = no cap.
# ASSISTANT_GLOBAL_WEEKLY_TURNS=1000
# Per-user messages per minute and turns in flight across all users (429 + Retry-After).
# ASSISTANT_PER_MINUTE=6
# ASSISTANT_CONCURRENCY=4
# Model requests (tool round-trips) per turn, and analysis sandbox runs per turn.
# ASSISTANT_MAX_STEPS=16
# SPORTS_ANALYSIS_RUNS_PER_TURN=3
# What the model sees of a thread: the last N turns verbatim, within a character budget.
# ASSISTANT_KEEP_TURNS=4
# ASSISTANT_HISTORY_CHARS=120000

# --- Garmin sync ---------------------------------------------------------------------------
# Default pull interval (hours) and pause between Garmin calls (seconds).
# GARMIN_PULL_HOURS=2
# GARMIN_PAUSE_S=1.0
# The token key is a file, not a variable: compose mounts ./secrets read-only and points
# GARMIN_TOKEN_KEY_FILE at ./secrets/garmin_token.key. Create it once:
#   mkdir -p secrets && openssl rand -base64 32 | tr '+/' '-_' > secrets/garmin_token.key
# No key: Garmin connect/sync are off, the rest of the app works.

# --- Limits --------------------------------------------------------------------------------
# Address-space limit of the attachment/media decoding worker.
# MEDIA_WORKER_MEM_MB=2048
# Disk use per account in MB (uploads are refused past it, and when the host has < 5 GiB free).
# USER_STORAGE_QUOTA_MB=4096

# --- Runaway alerts (optional) -------------------------------------------------------------
# With ALERT_WEBHOOK_URL set the app POSTs one JSON body per alert to it (ALERT_WEBHOOK_TOKEN,
# if set, is sent as the X-Sports-Token header). Unset: the warning is only logged.
# ALERT_WEBHOOK_URL=https://hooks.example.com/training-studio-alerts
# ALERT_WEBHOOK_TOKEN=
# Failed import runs in an hour before alerting.
# ALERT_FAILED_RUNS_PER_HOUR=6
# Per-account storage growth in a day before alerting, in MB.
# ALERT_STORAGE_GROWTH_MB=500
# Free space on the data disk below which to alert, in MB (uploads stop at 5 GiB).
# ALERT_FREE_DISK_MB=8192

# --- Feedback forwarding (optional) --------------------------------------------------------
# In-app feedback is always stored in the sender's own database. With FEEDBACK_WEBHOOK_URL
# set, a background outbox also POSTs each note there, with FEEDBACK_WEBHOOK_SECRET in the
# X-Sports-Token header (a URL without a secret fails closed). Unset: stored locally only.
# FEEDBACK_WEBHOOK_URL=
# FEEDBACK_WEBHOOK_SECRET=<32-plus-random-bytes>
# FEEDBACK_WEBHOOK_TIMEOUT_S=20
# FEEDBACK_DAILY_LIMIT=10
# Structured triage before forwarding, using the same Ollama key/model as the assistant.
# FEEDBACK_ENRICH=true
# FEEDBACK_ENRICH_TIMEOUT_S=25

# --- Runtime -------------------------------------------------------------------------------
# compose.yml sets APP_ENV=production, DATA_DIR and PYRUNNER_URL itself; with
# APP_ENV=production the app refuses to start without PYRUNNER_URL or with FAKE_TODAY set.
# ATHLETE_TZ=Europe/Amsterdam
# LOG_LEVEL=INFO
# LOG_FORMAT=                       # json | text (default: text in dev, json otherwise)
# APP_VERSION=dev
# Development and tests only:
# JOBS_ENABLED=true                 # false: no background job loop (tests drive it)
# FAKE_TODAY=                       # YYYY-MM-DD; demos, tests and evals only
