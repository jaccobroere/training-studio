     "rule.weekdays": [
      0
     ],
     "type": "skate",
     "time": "19:30"
    }
   }
  ],
  "tool_input": {
   "change": [
    "ice-skate"
   ]
  },
  "tool_input_not": {
   "change": [
    "\"tags\": \\[\"[^\\]]"
   ]
  }
 },
