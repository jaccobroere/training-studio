[
 {
  "id": "series-skating",
  "tier": "change",
  "message": "Add a weekly skating session every Monday at 19:30, 60 minutes, starting next week.",
  "writes": "change",
  "must_call": [
   "change"
  ],
  "ops": [
   {
    "op": "create_series",
